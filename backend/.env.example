# ==============================================================================
# I-ITSM Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in production values.
# NEVER commit the real `.env` file to version control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=I-ITSM
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
# Async PostgreSQL connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://iitsm:iitsm@localhost:5432/iitsm
DATABASE_ECHO=false

# ── JWT / Authentication ─────────────────────────────────────────────────────
# IMPORTANT: Generate a strong random secret for production.
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM Integration ─────────────────────────────────────────────────────────
# Provider: "mock" (for dev/testing), "openai", "azure", etc.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_ENABLED=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list or JSON list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ── Logging ──────────────────────────────────────────────────────────────────
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
